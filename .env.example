# Copy to .env and adjust if needed. Not committed.
MONGODB_URI=mongodb://localhost:27017/lets-play

# Generate your own, e.g.: openssl rand -base64 32
JWT_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional - off by default, HTTP works fine without any of this.
# To demo HTTPS locally: generate a self-signed keystore at the project
# root (see README), set SSL_ENABLED=true and SSL_KEYSTORE_PASSWORD to
# whatever password you gave it.
SSL_ENABLED=false
SSL_KEYSTORE_PATH=file:./keystore.p12
SSL_KEYSTORE_PASSWORD=